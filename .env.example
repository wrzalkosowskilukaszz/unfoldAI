# Required. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional access gate.
#   Unset  → the app is open (what you want locally).
#   Set    → every page and every API route requires this password first.
#
# Set this in your HOST's environment variables before the site is public.
# Without it, anyone who finds the URL can spend your Anthropic credits.
APP_PASSWORD=

# Durable rate limiting. Optional locally; REQUIRED in production.
#
# Without these the limiter counts in the function's own memory, and Vercel runs
# many instances — so the limit becomes per-instance rather than per-person and
# the AI spend ceiling effectively disappears.
#
# Create a free Redis database at https://console.upstash.com (or via the Vercel
# Marketplace) and paste its REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. When set, unhandled errors are forwarded to Sentry as well as
# logged. Without it you still get a reference id in the log and on screen.
SENTRY_DSN=

# Optional. Ceiling on AI calls per day across all users (default 1000). The
# per-address limit stops one person running up a bill; this stops many
# addresses doing it together. Sits under the hard cap in the Anthropic Console.
DAILY_AI_CALL_LIMIT=
